Build on Darwin

- src/utils.c: Darwin's struct stat names the modification time
  st_mtimespec, not st_mtim.
- dunstify.c: the global `wait` (the --wait option) collides with libc's
  wait(), which Darwin's <stdlib.h> declares; renamed `wait_close`.
- config.mk: no -lrt on Darwin, whose libSystem has those functions.

The Wayland code's <linux/input-event-codes.h> comes from the
linux-input-headers package in the Nix scope, not from a patch.

Drop when: dunst builds on Darwin upstream.

diff --git a/config.mk b/config.mk
index ba46157..e741f92 100644
--- a/config.mk
+++ b/config.mk
@@ -60,7 +60,11 @@ endif
 # flags
 DEFAULT_CPPFLAGS = -D_DEFAULT_SOURCE -DVERSION=\"${VERSION}\" -DSYSCONFDIR=\"${SYSCONFDIR}\" ${ENABLE_WAYLAND} ${ENABLE_X11}
 DEFAULT_CFLAGS   = -g -std=gnu11 -pedantic -Wall -Wno-overlength-strings -Wno-expansion-to-defined -Os
-DEFAULT_LDFLAGS  = -lm -lrt
+DEFAULT_LDFLAGS  = -lm
+# Darwin has no separate librt (its functions are in libSystem).
+ifneq ($(shell uname -s),Darwin)
+DEFAULT_LDFLAGS += -lrt
+endif
 
 CPPFLAGS_DEBUG :=
 CFLAGS_DEBUG   := -O0
