diff --git a/src/utils.c b/src/utils.c
index feda779..1456d00 100644
--- a/src/utils.c
+++ b/src/utils.c
@@ -344,7 +344,11 @@ gint64 modification_time(const char *path)
         if (!path || stat(path, &statbuf) != 0)
                 return -1;
 
+#ifdef __APPLE__
+        return S2US(statbuf.st_mtimespec.tv_sec) + statbuf.st_mtimespec.tv_nsec / 1000;
+#else
         return S2US(statbuf.st_mtim.tv_sec) + statbuf.st_mtim.tv_nsec / 1000;
+#endif
 }
 
