Build on Darwin: pipe2(), SOCK_CLOEXEC and MSG_NOSIGNAL are missing there.
Adds include/util/darwin_compat.hpp (empty elsewhere) and includes it where they
are used: pipe2 from pipe() + fcntl(), SOCK_CLOEXEC and MSG_NOSIGNAL as 0. Also
custom_graph.cpp passes a call to WEXITSTATUS, which Darwin's macro can't take
(it takes the address of its argument): store the status in a variable first.
And meson.build builds the cffi module only on Linux and the BSDs, though the
module factory always refers to it: build it on Darwin too.

diff --git a/include/util/command.hpp b/include/util/command.hpp
index 15d7b8c..6af5694 100644
--- a/include/util/command.hpp
+++ b/include/util/command.hpp
@@ -6,6 +6,8 @@
 #include <sys/wait.h>
 #include <unistd.h>
 
+#include "util/darwin_compat.hpp"
+
 #ifdef __linux__
 #include <sys/prctl.h>
 #include <sys/syscall.h>
diff --git a/include/util/darwin_compat.hpp b/include/util/darwin_compat.hpp
new file mode 100644
index 0000000..fdbdb4e
--- /dev/null
+++ b/include/util/darwin_compat.hpp
@@ -0,0 +1,37 @@
+#pragma once
+
+// Darwin lacks a few Linux/BSD calls Waybar uses. This header is a no-op
+// elsewhere.
+
+#ifdef __APPLE__
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+// socket() takes no flags on Darwin. The socket is left inheritable; children
+// Waybar spawns mark inherited descriptors close-on-exec themselves
+// (util::command::setInheritedFdsCloexec).
+#ifndef SOCK_CLOEXEC
+#define SOCK_CLOEXEC 0
+#endif
+
+// No MSG_NOSIGNAL on Darwin (only SO_NOSIGPIPE per socket).
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#endif
+
+// pipe2() as pipe() and fcntl(): not atomic, which only matters if another
+// thread forks in between.
+static inline int pipe2(int fd[2], int flags) {
+  if (pipe(fd) != 0) return -1;
+  for (int i = 0; i < 2; ++i) {
+    if ((flags & O_CLOEXEC) && fcntl(fd[i], F_SETFD, FD_CLOEXEC) != 0) goto fail;
+    if ((flags & O_NONBLOCK) && fcntl(fd[i], F_SETFL, fcntl(fd[i], F_GETFL) | O_NONBLOCK) != 0) goto fail;
+  }
+  return 0;
+fail:
+  close(fd[0]);
+  close(fd[1]);
+  return -1;
+}
+#endif
