         return TRUE;
 
-#ifdef __APPLE__
+#ifdef GDK_WINDOWING_MACOS
       if (bevent->button == GDK_BUTTON_PRIMARY &&
           (bevent->state & GDK_CONTROL_MASK) &&
           ! (bevent->state & (GDK_BUTTON1_MASK | GDK_BUTTON2_MASK)))
